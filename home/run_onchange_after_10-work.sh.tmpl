{{ if .work -}}
#!/usr/bin/env bash
# Unpack the work bundle into the home directory and the work fragments into ~/.config/dotfiles-work.
{{ range glob (joinPath .chezmoi.sourceDir ".work/*.age") -}}
# {{ base . }} {{ include . | sha256sum }}
{{ end -}}
set -eu
identity="$HOME/.config/chezmoi/key.txt"
work={{ joinPath .chezmoi.sourceDir ".work" | quote }}
fragments="$HOME/.config/dotfiles-work/fragments"

age -d -i "$identity" "$work/bundle.tar.age" | tar -xf - -C "$HOME"

mkdir -p "$fragments"
for fragment in "$work"/*.age; do
  name="$(basename "$fragment" .age)"
  [ "$name" = bundle.tar ] && continue
  age -d -i "$identity" "$fragment" > "$fragments/$name"
done
{{ end -}}
