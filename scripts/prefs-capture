#!/usr/bin/env bash
# Copy the current Rectangle settings into the repository, without the keys that change on each update.
set -eu
repo="$(cd "$(dirname "$0")/.." && pwd)"
target="$repo/home/.prefs/com.knollsoft.Rectangle.plist"

mkdir -p "$(dirname "$target")"
defaults export com.knollsoft.Rectangle - | plutil -convert xml1 -o "$target" -
for key in SUHasLaunchedBefore SULastCheckTime installVersion lastVersion; do
  plutil -remove "$key" "$target" 2>/dev/null || true
done
echo "Wrote $target"
