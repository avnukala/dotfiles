#!/usr/bin/env bash
# Encrypt the work files into home/.work. Run it after you change a file in the manifest or a fragment.
set -eu
repo="$(cd "$(dirname "$0")/.." && pwd)"
work="$repo/home/.work"
config="$HOME/.config/dotfiles-work"
identity="$HOME/.config/chezmoi/key.txt"
recipient="$(age-keygen -y "$identity")"
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

cd "$HOME"
COPYFILE_DISABLE=1 tar --no-mac-metadata --exclude .DS_Store --exclude __pycache__ -cf "$scratch/new.tar" -T "$config/manifest"
mkdir "$scratch/old" "$scratch/new"
tar -xf "$scratch/new.tar" -C "$scratch/new"
if [ -f "$work/bundle.tar.age" ]; then
  age -d -i "$identity" "$work/bundle.tar.age" | tar -xf - -C "$scratch/old"
fi
if diff -r "$scratch/old" "$scratch/new"; then
  echo "bundle.tar: no change"
else
  age -r "$recipient" -o "$work/bundle.tar.age" "$scratch/new.tar"
  echo "bundle.tar: updated"
fi

for fragment in "$config"/fragments/*; do
  name="$(basename "$fragment")"
  target="$work/$name.age"
  if [ -f "$target" ] && age -d -i "$identity" "$target" | cmp -s - "$fragment"; then
    echo "$name: no change"
    continue
  fi
  age -r "$recipient" -o "$target" "$fragment"
  echo "$name: updated"
done
