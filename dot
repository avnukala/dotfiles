#!/usr/bin/env bash
# Link and apply the dotfiles in this repository, and pack the encrypted work files.
set -eu

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
LINKS="$REPO/links.txt"
BUNDLE="$REPO/work/bundle.tar.age"
KEY="$HOME/.config/age/dotfiles.txt"
WORK="$HOME/.config/dotfiles-work"
WORK_FILES="$WORK/files.txt"
RECTANGLE="com.knollsoft.Rectangle"
RECTANGLE_PLIST="$REPO/rectangle/$RECTANGLE.plist"

usage() {
  cat <<EOF
Usage: dot <command>

  apply          link, unpack the work bundle, write settings, run brew bundle, and apply macOS settings
  link           link the public files in links.txt into \$HOME
  add <live path> <repository path>
                 copy a live file into this repository, list it in links.txt, and link it
  pack           encrypt the files in $WORK_FILES into work/bundle.tar.age
  rectangle      copy the current Rectangle settings into rectangle/

A Mac with $KEY is a work Mac.
EOF
}

die() { echo "dot: $*" >&2; exit 1; }

is_work() { [ -f "$KEY" ]; }

link_file() {
  local source="$1" target="$2"
  if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then return; fi
  if [ -d "$target" ] && [ ! -L "$target" ]; then
    echo "skip $target: it is a directory"
    return
  fi
  if [ -e "$target" ] && ! cmp -s "$source" "$target"; then
    echo "skip $target: it differs from the repository. Run 'dot add' on it to keep the live file, or delete it."
    return
  fi
  mkdir -p "$(dirname "$target")"
  ln -sfn "$source" "$target"
  echo "linked $target"
}

link() {
  local line repository_path home_path file
  while IFS= read -r line; do
    case "$line" in
      '' | '#'*) continue ;;
    esac
    repository_path="$REPO/${line%% -> *}"
    home_path="$HOME/${line#* -> }"
    if [ -d "$repository_path" ]; then
      while IFS= read -r -d '' file; do
        link_file "$file" "$home_path/${file#"$repository_path"/}"
      done < <(find "$repository_path" \( -type f -o -type l \) ! -name .DS_Store ! -path '*/__pycache__/*' -print0)
    elif [ -e "$repository_path" ]; then
      link_file "$repository_path" "$home_path"
    else
      echo "skip $home_path: ${line%% -> *} is missing from the repository"
    fi
  done < "$LINKS"
}

add() {
  local target="$1" repository_path="$2"
  target="$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"
  case "$target" in
    "$HOME"/*) ;;
    *) die "$target is not in $HOME" ;;
  esac
  [ -f "$target" ] && [ ! -L "$target" ] || die "$target is not a regular file"
  mkdir -p "$(dirname "$REPO/$repository_path")"
  cp -p "$target" "$REPO/$repository_path"
  grep -qxF "$repository_path -> ${target#"$HOME"/}" "$LINKS" || echo "$repository_path -> ${target#"$HOME"/}" >> "$LINKS"
  ln -sfn "$REPO/$repository_path" "$target"
  echo "added $target"
}

# Apps rewrite these files and add keys for each Mac, so they are written, not linked.
write_settings() {
  local target="$1" shared="$2" work="$3" filter="$4" current content
  current="$target"
  [ -f "$current" ] || current=/dev/null
  is_work || work=/dev/null
  content="$(jq -n --slurpfile current "$current" --slurpfile shared "$shared" --slurpfile work "$work" "$filter")"
  if [ -f "$target" ] && [ "$(cat "$target")" = "$content" ]; then return; fi
  mkdir -p "$(dirname "$target")"
  printf '%s\n' "$content" > "$target"
  echo "wrote $target"
}

settings() {
  write_settings "$HOME/.pi/agent/settings.json" "$REPO/pi/settings.json" "$WORK/pi-settings.json" \
    '(($current[0] // {}) * $shared[0]) as $merged | $merged + {skills: (($work[0].skills // []) + $merged.skills)}'
  write_settings "$HOME/.claude/settings.json" "$REPO/claude/settings.json" "$WORK/claude-settings.json" \
    '($current[0] // {}) * $shared[0] * ($work[0] // {})'
}

brew_bundle() {
  local brewfile
  for brewfile in "$REPO/Brewfile" "$HOME/.Brewfile.work"; do
    [ -f "$brewfile" ] || continue
    brew bundle check --no-upgrade --file "$brewfile" >/dev/null || brew bundle install --no-upgrade --file "$brewfile"
  done
}

macos() {
  defaults write NSGlobalDomain KeyRepeat -float 2
  defaults write NSGlobalDomain InitialKeyRepeat -float 15
  defaults write NSGlobalDomain AppleShowAllExtensions -bool true
  defaults write NSGlobalDomain AppleInterfaceStyle -string Dark
  defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false
  defaults write com.apple.dock autohide -bool true
  defaults write com.apple.dock orientation -string left
  defaults write com.apple.finder FXPreferredViewStyle -string clmv
  defaults write com.apple.AppleMultitouchTrackpad Clicking -int 0
  defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool false
}

# Leaves out the keys that Rectangle changes on each update, so the file changes only with the settings.
export_rectangle() {
  defaults export "$RECTANGLE" - | plutil -convert xml1 -o "$1" -
  for key in SUHasLaunchedBefore SULastCheckTime installVersion lastVersion; do
    plutil -remove "$key" "$1" 2>/dev/null || true
  done
}

rectangle() {
  local current
  current="$(mktemp)"
  export_rectangle "$current"
  if ! cmp -s "$current" "$RECTANGLE_PLIST"; then
    # Rectangle writes its settings on quit, so stop it before the import.
    pkill -x Rectangle || true
    defaults import "$RECTANGLE" "$RECTANGLE_PLIST"
    open -a Rectangle || true
    echo "imported Rectangle settings"
  fi
  rm -f "$current"
}

# Existing files are kept, because the live work files are newer than the bundle until the next pack.
unpack() {
  age -d -i "$KEY" "$BUNDLE" | tar -xkf - -C "$HOME"
}

pack() {
  local scratch
  is_work || die "$KEY is missing"
  scratch="$(mktemp -d)"
  trap "rm -rf '$scratch'" EXIT
  mkdir "$scratch/old" "$scratch/new"
  (cd "$HOME" && COPYFILE_DISABLE=1 tar --no-mac-metadata --exclude .DS_Store --exclude __pycache__ -cf "$scratch/new.tar" -T "$WORK_FILES")
  tar -xf "$scratch/new.tar" -C "$scratch/new"
  if [ -f "$BUNDLE" ]; then
    age -d -i "$KEY" "$BUNDLE" | tar -xf - -C "$scratch/old"
  fi
  if diff -r "$scratch/old" "$scratch/new"; then
    echo "bundle: no change"
    return
  fi
  mkdir -p "$(dirname "$BUNDLE")"
  age -r "$(age-keygen -y "$KEY")" -o "$BUNDLE" "$scratch/new.tar"
  echo "bundle: updated"
}

apply() {
  if [ -f "$WORK_FILES" ] && ! is_work; then
    die "$WORK_FILES exists but $KEY is missing. Restore the key, or this Mac loses its work settings."
  fi
  link
  if is_work; then unpack; fi
  settings
  "$HOME/.config/agents/sync-skills.sh" | grep -v '^ok ' || true
  "$HOME/.config/launchd/sched" apply
  brew_bundle
  macos
  rectangle
}

case "${1:-}" in
  apply) apply ;;
  link) link ;;
  add) [ "$#" -eq 3 ] || die "usage: dot add <live path> <repository path>"; add "$2" "$3" ;;
  pack) pack ;;
  rectangle) export_rectangle "$RECTANGLE_PLIST"; echo "wrote $RECTANGLE_PLIST" ;;
  *) usage; exit 2 ;;
esac
