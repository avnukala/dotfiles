{{- /* chezmoi:modify-template */ -}}
{{- /* Keep keys that pi writes per machine, such as deviceId, and replace the shared keys. */ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin }}{{ $settings = fromJson .chezmoi.stdin }}{{ end -}}
{{- $settings = mergeOverwrite $settings (include "dot_pi/agent/.settings.shared.json" | fromJson) -}}
{{- if .work -}}
{{-   $work := include ".work/pi-settings.json.age" | decrypt | fromJson -}}
{{-   $settings = set $settings "skills" (concat $work.skills $settings.skills) -}}
{{- end -}}
{{ toPrettyJson $settings }}
